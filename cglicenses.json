// -----------------------------------------------------------------------------------------
// -----------------------------------------------------------------------------------------
// This file overrides licenses only for OSS components which do not appear in `cgmanifest.json`.
// i.e. for OSS components that are detected from `package-lock.json` or `Cargo.lock` files.
//
// F120 S2+S3+S4 (docs/research/2026-07-29-branding-packaging.md "结论 3.6",
// progress.md's F120 S2+S3+S4 entry): trimmed from ~70 entries down to the
// single one below. Every other entry (typescript, tunnel-agent,
// reflect-metadata, vscode-tas-client, tas-client, @enonic/fnv-plus,
// @vscode/win32-app-container-tokens, @vscode/deviceid, @tokenizer/token,
// concat-map, github-from-package, minimist, openssl-macros,
// https-proxy-agent, data-uri-to-buffer, socks-proxy-agent,
// http-proxy-agent, agent-base, anstyle*, anstream, colorchoice,
// cacheable-request, @vscode/ts-package-manager,
// vscode-markdown-languageserver, chownr, @azure/msal-node-runtime,
// robust-predicates, balanced-match, wit-*, wasm-*, all @github/copilot*,
// tweetnacl, @vscode/fs-copyfile, @anthropic-ai/claude-agent-sdk,
// @github/blackbird-external-ingest-utils, @microsoft/dev-tunnels-*,
// brorand, emitter-listener, bignumber.js, miller-rabin, randombytes, ahp*,
// @iconify-json/*, @microsoft/mxc-sdk, @vscode/diff, dlv, @vscode/l10n,
// @xterm/addon-serialize, @vscode/windows-ca-certs,
// @vscode/markdown-editor, linux-keyutils, onnxruntime-node) was verified
// to have zero matches anywhere in this repo's current `pnpm-lock.yaml`
// (`grep` across the full lockfile, not just direct dependencies) - these
// were all detected from the *old* Code OSS/Electron `package-lock.json` or
// `Cargo.lock`, which no longer exist in this repository (see
// `docs/f110-s1-legacy-source-removal-manifest.md`). `typescript` is a real
// current devDependency (`package.json`), but is a build/type-check-only
// tool never bundled into `dist/` output, so it does not need a shipped-code
// attribution and was removed too. `jschardet` is confirmed real,
// currently-shipped (a ~333 KB production `dist/` chunk) - kept, and is the
// same reason F120 exists in the first place: this project's
// `ThirdPartyNotices.txt` had zero attribution for it before this rewrite.
//
// DO NOT EDIT THIS FILE UNLESS THE OSS TOOL INDICATES THAT YOU SHOULD.
//
[
	{
		// Reason: The license at https://github.com/aadsm/jschardet/blob/master/LICENSE
		// does not include a clear Copyright statement and does not credit authors.
		"name": "jschardet",
		"prependLicenseText": [
			"Chardet was originally ported from C++ by Mark Pilgrim. It is now maintained",
			" by Dan Blanchard and Ian Cordasco, and was formerly maintained by Erik Rose.",
			" JSChardet was ported from python to JavaScript by António Afonso ",
			" (https://github.com/aadsm/jschardet) and transformed into an npm package by ",
			"Markus Ast (https://github.com/brainafk)"
		]
	}
]
